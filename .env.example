# Copie ce fichier en .env (à la racine en local, à côté du docker-compose.yml sur le VPS).
# Sans ces trois valeurs, le jeu fonctionne en mode invité uniquement.

# Supabase → Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Clé publique « anon » : envoyée aux navigateurs, sans danger.
SUPABASE_ANON_KEY=
# Clé « service_role » : SECRÈTE, donne tous les droits sur la base. Ne jamais la commiter ni la partager.
SUPABASE_SERVICE_ROLE_KEY=
